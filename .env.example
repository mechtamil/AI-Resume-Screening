# RecruitOS deployment example. Copy to a local .env only for local tooling.
# Never commit the real .env or Streamlit secrets file.

RECRUITOS_ENVIRONMENT=production
RECRUITOS_INITIAL_SETUP_KEY=replace-with-a-long-random-secret
RECRUITOS_AUTH_SESSION_HOURS=8
RECRUITOS_AUTH_MAX_FAILED_LOGINS=5
RECRUITOS_AUTH_LOCKOUT_MINUTES=15
RECRUITOS_TEMP_PASSWORD_EXPIRY_DAYS=7
RECRUITOS_TEMP_PASSWORD_MIN_LENGTH=6
RECRUITOS_PERMANENT_PASSWORD_MIN_LENGTH=8
RECRUITOS_MAX_RESUMES_PER_SCREENING=100

# Local-only bootstrap without a setup key. Keep false in every shared deploy.
RECRUITOS_ALLOW_INSECURE_LOCAL_BOOTSTRAP=false

# OCR runtime configuration.
# Leave RECRUITOS_TESSERACT_CMD empty when "tesseract" is available on PATH.
# Set it only in the local/hosted environment when an explicit executable is required.
RECRUITOS_TESSERACT_CMD=
RECRUITOS_OCR_LANGUAGES=eng
RECRUITOS_OCR_PSM=3

# AI provider deployment settings. Store real keys only in a local .env or
# Streamlit secrets; never commit them.
RECRUITOS_OPENAI_API_KEY=
RECRUITOS_OPENAI_BASE_URL=https://api.openai.com/v1
RECRUITOS_OLLAMA_BASE_URL=http://127.0.0.1:11434
RECRUITOS_AI_HTTP_TIMEOUT_SECONDS=60
RECRUITOS_AI_MAX_RESPONSE_BYTES=2000000
RECRUITOS_AI_DEFAULT_MAX_INPUT_CHARS=120000
RECRUITOS_AI_DEFAULT_DAILY_REQUEST_LIMIT=100
